+def _sm90_cutedsl_pair_env(name: str, default: tuple[int, int]) -> tuple[int, int]:
+    value = os.environ.get(name)
+    if not value:
+        return default
+    parts = value.lower().replace(",", "x").split("x")
+    if len(parts) != 2:
+        raise ValueError(f"{name} must be formatted as MxN, got {value!r}")
+    result = (int(parts[0]), int(parts[1]))
+    if min(result) <= 0:
+        raise ValueError(f"{name} dimensions must be positive, got {value!r}")
+    return result
+
+
+def _sm90_cutedsl_raster_env(name: str, default_along_m: bool) -> bool:
+    value = os.environ.get(name)
+    if not value:
+        return default_along_m
+    value = value.lower()
+    if value not in {"m", "n"}:
+        raise ValueError(f"{name} must be 'm' or 'n', got {value!r}")
+    return value == "m"
+
+
